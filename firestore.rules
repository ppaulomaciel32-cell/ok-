rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function dono() {
      return logado() && request.auth.token.email == 'p.paulomaciel.32@gmail.com';
    }
    function liberado() {
      return dono() || (logado() && exists(/databases/$(database)/documents/members/$(request.auth.token.email)));
    }

    match /members/{email} {
      allow read: if liberado();
      allow write: if dono();
    }

    match /{colecao}/{documento} {
      allow read, write: if colecao != 'members' && liberado();
    }

    match /{colecao}/{documento}/{sub=**} {
      allow read, write: if colecao != 'members' && liberado();
    }
  }
}
